# Blockchain integration for the vending-machine sandbox.
#
# Mode: live | mock | dryrun
#   live   -- submit txs to RPC_URL; required when running against anvil.
#   mock   -- use the in-memory MockTaskRegistryClient (default for tests).
#   dryrun -- write the journal but skip on-chain submission.
BLOCKCHAIN_MODE=mock

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# anvil's first default test account (matches scripts/deploy_local.sh).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Filled in by scripts/deploy_local.sh after `forge script`.
CONTRACT_ADDRESS=

CONFIRM_BLOCKS=1
TX_TIMEOUT_SEC=30
